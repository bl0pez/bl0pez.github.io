---
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GuideCard from '../../components/GuideCard.astro';
import DiscordBand from '../../components/DiscordBand.astro';
import { categorias } from '../../data/tutoriales';
---

<Page
  title="Tutoriales: videos con IA, Roblox y webs | Bryan López"
  description="Guías gratis y en español para crear shorts con IA, juegos en Roblox y webs con IA. Herramientas, instalación y prompts listos para copiar."
  current="tutoriales"
>
  <div class="wrap intro">
    <Breadcrumbs items={[{ href: '/', label: 'Inicio' }, { href: '/tutoriales/', label: 'Tutoriales' }]} />
    <h1 class="page-title">Tutoriales</h1>
    <p class="section-lead">Lo que uso para hacer mis videos, juegos y webs, explicado para que lo hagas tú. Gratis, en español y con los prompts listos para copiar.</p>
  </div>

  <div class="wrap cats">
    {categorias.map((cat) => (
      <section class="tile cat" id={cat.id} aria-labelledby={`h-${cat.id}`}>
        <div class="cat-head">
          <Icon name={cat.icon} size={28} class="cat-icon" />
          <div>
            <h2 id={`h-${cat.id}`}>{cat.title}</h2>
            <p class="muted">{cat.text}</p>
          </div>
        </div>
        {cat.tutoriales.length > 0 ? (
          <div class="guides">
            {cat.tutoriales.map((t) => <GuideCard tutorial={t} />)}
          </div>
        ) : (
          <p class="soon">Próximamente</p>
        )}
      </section>
    ))}
  </div>

  <DiscordBand />
</Page>

<style>
  .intro {
    display: grid;
    gap: 20px;
    padding-top: clamp(28px, 5vw, 56px);
  }

  .cats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(32px, 5vw, 56px);
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 28px 30px;
    scroll-margin-top: 96px;
  }

  .cat-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
  }

  .cat-head :global(.cat-icon) {
    color: var(--color-green-ink);
    margin-top: 4px;
  }

  h2 {
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .guides {
    display: grid;
    gap: 12px;
    margin-top: auto;
  }

  .soon {
    margin-top: auto;
    align-self: flex-start;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-muted);
    font-weight: 600;
    font-size: 0.875rem;
  }

  @media (max-width: 899px) {
    .cats {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767px) {
    .cats {
      gap: 12px;
    }

    .cat {
      padding: 24px;
    }
  }
</style>
