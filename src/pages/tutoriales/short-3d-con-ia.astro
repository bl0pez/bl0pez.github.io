---
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CopyButton from '../../components/CopyButton.astro';
import DiscordBand from '../../components/DiscordBand.astro';
import ejemplo from '../../assets/guias/short-3d-ejemplo.png';

const herramientas = [
  {
    id: 'claude',
    icon: 'terminal-window',
    name: 'Claude Code',
    what: 'La IA que escribe el guion, programa la escena 3D y arma el video. Necesita una cuenta de Claude con plan Pro o superior.',
    install: 'irm https://claude.ai/install.ps1 | iex',
    link: { href: 'https://claude.com/claude-code', label: 'claude.com/claude-code' },
  },
  {
    id: 'node',
    icon: 'hexagon',
    name: 'Node.js',
    what: 'Corre Three.js (el motor 3D) y graba la animación cuadro por cuadro.',
    install: 'winget install OpenJS.NodeJS.LTS',
  },
  {
    id: 'python',
    icon: 'file-py',
    name: 'Python',
    what: 'Genera la voz gratis con edge-tts, sin claves ni cuentas.',
    install: 'winget install Python.Python.3.12',
  },
  {
    id: 'ffmpeg',
    icon: 'film-strip',
    name: 'ffmpeg',
    what: 'Une las imágenes y la voz en el video final .mp4.',
    install: 'winget install Gyan.FFmpeg',
  },
];

const pasos = [
  {
    title: 'Instala las herramientas',
    text: 'Abre PowerShell y pega los cuatro comandos de arriba, uno por uno. Cuando terminen, cierra PowerShell y ábrelo de nuevo.',
  },
  {
    title: 'Crea una carpeta para tu video',
    text: 'Por ejemplo C:\\videos\\mi-primer-short. Ábrela en PowerShell y escribe claude. La primera vez te pide iniciar sesión con tu cuenta de Claude.',
  },
  {
    title: 'Pega el prompt',
    text: 'Copia el prompt de abajo, cambia [TU IDEA] por el tema de tu video y pégalo. Claude te muestra el guion antes de seguir: si no te gusta, pídele cambios con tus palabras.',
  },
  {
    title: 'Revisa y sube',
    text: 'Cuando termine te abre video.mp4. Pídele ajustes ("más rápido", "otro color", "subtítulos más grandes") hasta que te guste y súbelo.',
  },
];

const prompt = `Quiero hacer un short vertical en 3D (1080x1920, 30 fps, unos 30 segundos) sobre: [TU IDEA].

Hazlo tú todo dentro de esta carpeta y explícame cada paso en simple, sin palabras técnicas:

1. Escribe un guion corto en español: la primera frase es una pregunta que dé curiosidad y después 3 o 4 datos sorprendentes. Muéstramelo y espera mi visto bueno.
2. Genera la voz gratis con edge-tts (voz es-MX-JorgeNeural, velocidad +8%) y guarda en qué momento se dice cada palabra.
3. Haz un index.html con Three.js: una escena 3D sencilla con formas y colores vivos que cambie con cada frase, una cámara que se mueva suave y subtítulos grandes palabra por palabra en el centro de la pantalla.
4. Graba la animación cuadro por cuadro con Playwright (no grabes la pantalla) y une las imágenes con la voz usando ffmpeg en un archivo video.mp4.
5. Ábreme el video y dime tres cosas que podría mejorar.

Si falta instalar algo, instálalo tú o dame el comando exacto para PowerShell.`;
---

<Page
  title="Tu primer short 3D con Claude Code | Tutoriales | Bryan López"
  description="Las 4 herramientas gratis que necesitas, cómo instalarlas en Windows y el prompt para que Claude Code haga un short 3D con voz y subtítulos por ti."
  current="tutoriales"
>
  <div class="wrap guide">
    <Breadcrumbs items={[
      { href: '/', label: 'Inicio' },
      { href: '/tutoriales/', label: 'Tutoriales' },
      { href: '/tutoriales/short-3d-con-ia/', label: 'Short 3D con Claude Code' },
    ]} />

    <header class="guide-head">
      <div>
        <h1 class="page-title">Tu primer short 3D con Claude Code</h1>
        <p class="section-lead">Tú pones la idea y Claude escribe el guion, le pone voz, arma la animación 3D con subtítulos y te entrega el .mp4. Sin editar y sin saber programar.</p>
        <ul class="meta">
          <li><Icon name="clock" size={18} />15 min</li>
          <li><Icon name="windows-logo" size={18} />Windows</li>
          <li><Icon name="student" size={18} />Principiante</li>
        </ul>
      </div>
      <figure class="tile sample">
        <Image src={ejemplo} alt="Portada de un short hecho así: ¿cuánto tardas en cruzar la Tierra?" widths={[300, 450, 600]} sizes="(max-width: 767px) 70vw, 300px" loading="eager" />
        <figcaption class="muted">Un short hecho con este método</figcaption>
      </figure>
    </header>

    <section class="section" aria-labelledby="h-herr">
      <h2 class="section-title" id="h-herr">Lo que necesitas</h2>
      <p class="section-lead">Cuatro herramientas. Todas gratis menos Claude, que pide plan Pro. Los comandos son para Windows (PowerShell).</p>
      <div class="tools">
        {herramientas.map((h) => (
          <article class="tile tool">
            <Icon name={h.icon} size={28} class="tool-icon" />
            <div class="tool-body">
              <h3>{h.name}</h3>
              <p class="muted">{h.what}</p>
              <div class="cmd">
                <code id={`cmd-${h.id}`}>{h.install}</code>
                <CopyButton target={`cmd-${h.id}`} what={`el comando para instalar ${h.name}`} />
              </div>
              {h.link && <a class="ink-link" href={h.link.href} target="_blank" rel="noopener">{h.link.label}</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="h-pasos">
      <h2 class="section-title" id="h-pasos">Paso a paso</h2>
      <ol class="steps">
        {pasos.map((p, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="prompt" aria-labelledby="h-prompt">
      <h2 class="section-title" id="h-prompt">El prompt</h2>
      <p class="section-lead">Cópialo tal cual y cambia solo lo que está entre corchetes. Ideas que funcionan: «¿por qué el mar es salado?», «qué pasa si cavas un túnel al centro de la Tierra», «cómo se hace un chip».</p>
      <div class="tile prompt">
        <div class="prompt-bar">
          <span>prompt.txt</span>
          <CopyButton target="prompt-text" what="el prompt" label="Copiar prompt" />
        </div>
        <pre tabindex="0"><code id="prompt-text">{prompt}</code></pre>
      </div>
      <p class="note muted">Es un punto de partida. El que uso en mis videos agrega música, efectos de sonido y reglas para que la gente no deslice; lo comparto en el Discord.</p>
    </section>
  </div>

  <DiscordBand title="¿Algo no te funcionó?" text="Pásate por el Discord: ahí resolvemos errores de instalación, compartimos videos y dejo los prompts nuevos." />
</Page>

<style>
  .guide {
    padding-top: clamp(28px, 5vw, 56px);
  }

  .guide-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
    align-items: end;
    margin-top: 20px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin-top: 24px;
  }

  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-tile);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .sample {
    overflow: hidden;
  }

  .sample :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 40%;
  }

  .sample figcaption {
    padding: 12px 18px 14px;
    font-size: 0.9375rem;
  }

  h3 {
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .tool {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    padding: 28px 30px;
  }

  .tool :global(.tool-icon) {
    color: var(--color-green-ink);
    margin-top: 2px;
  }

  .tool-body {
    min-width: 0;
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .cmd {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding: 8px 8px 8px 16px;
    background: var(--color-bg);
    border-radius: 999px;
  }

  .cmd code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.875rem;
    scrollbar-width: thin;
  }

  .ink-link {
    color: var(--color-cyan-ink);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  .steps li {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .prompt {
    margin-top: 32px;
  }

  .prompt-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px 14px 24px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .prompt pre {
    padding: 24px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9375rem;
    line-height: 1.65;
    border-radius: 0 0 var(--radius-tile) var(--radius-tile);
  }

  .note {
    margin-top: 16px;
    max-width: 62ch;
  }

  @media (max-width: 1099px) {
    .tools {
      grid-template-columns: minmax(0, 1fr);
    }

    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 36px;
    }
  }

  @media (max-width: 767px) {
    .guide-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .sample {
      max-width: 320px;
    }

    .tools {
      gap: 12px;
    }

    .tool {
      padding: 24px;
      grid-template-columns: minmax(0, 1fr);
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .prompt pre {
      padding: 20px;
      font-size: 0.875rem;
    }
  }
</style>
