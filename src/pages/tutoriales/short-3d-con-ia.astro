---
import { Image } from 'astro:assets';
import Page from '../../layouts/Page.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CopyButton from '../../components/CopyButton.astro';
import DiscordBand from '../../components/DiscordBand.astro';
import ejemplo from '../../assets/guias/short-3d-ejemplo.png';

// Apps de escritorio que pueden trabajar dentro de una carpeta de tu computador.
// Precios y planes verificados en sus páginas oficiales (nov. 2026); cambian seguido.
const apps = [
  {
    id: 'claude',
    icon: 'asterisk',
    name: 'Claude',
    de: 'Anthropic',
    precio: 'Plan Pro o superior',
    nota: 'La que uso yo. La más constante en tareas largas como esta.',
    donde: 'Pestaña Code → Local → Open folder…',
    link: { href: 'https://claude.com/download', label: 'claude.com/download' },
    recomendada: true,
  },
  {
    id: 'chatgpt',
    icon: 'chat-circle-dots',
    name: 'ChatGPT (Codex)',
    de: 'OpenAI',
    precio: 'Gratis con límites',
    nota: 'El plan gratis trae Codex para tareas cortas; con Plus rinde más.',
    donde: 'Codex → elige la carpeta del proyecto',
    link: { href: 'https://chatgpt.com/download', label: 'chatgpt.com/download' },
  },
  {
    id: 'antigravity',
    icon: 'sparkle',
    name: 'Antigravity (Gemini)',
    de: 'Google',
    precio: 'Gratis con cuota semanal',
    nota: 'La app de agentes de Google. Ojo: la app de Gemini normal es solo chat y no sirve para esto.',
    donde: 'Abre la carpeta como espacio de trabajo',
    link: { href: 'https://antigravity.google/download', label: 'antigravity.google' },
  },
  {
    id: 'opencode',
    icon: 'code',
    name: 'OpenCode',
    de: 'Código abierto',
    precio: 'Gratis, sin cuenta',
    nota: 'Trae modelos gratis. Son más lentos y se pierden más: ve paso a paso.',
    donde: 'Abre la carpeta del proyecto',
    link: { href: 'https://opencode.ai/download', label: 'opencode.ai/download' },
  },
];

const herramientas = [
  { icon: 'hexagon', name: 'Node.js', what: 'Hace funcionar Three.js, el motor 3D, y la grabadora de cuadros (Playwright).' },
  { icon: 'file-py', name: 'Python + edge-tts', what: 'Pone la voz al guion, gratis y sin cuentas, con las voces de Microsoft.' },
  { icon: 'film-strip', name: 'ffmpeg', what: 'Junta las imágenes y la voz en el video final .mp4.' },
];

const pasos = [
  {
    id: 'instalar',
    title: 'Instala lo que falta',
    why: 'La IA revisa tu computador e instala Node.js, Python, edge-tts, Playwright y ffmpeg. Tú solo apruebas.',
    prompt: `Revisa si en este computador están instalados Node.js, Python, la librería edge-tts de Python, Playwright con su navegador y ffmpeg. Instala con winget, pip o npm solo lo que falte, sin preguntarme por cada uno.

Al terminar, dime en una frase para qué sirve cada herramienta y confirma que funcionan mostrando sus versiones.`,
    tips: [
      'La app te pide permiso antes de ejecutar cada comando: léelo y acepta.',
      'Si dice que winget no existe, actualiza "Instalador de aplicación" desde Microsoft Store y vuelve a pedírselo.',
      'Si después no encuentra lo que instaló, cierra la app, ábrela de nuevo en la misma carpeta y sigue.',
    ],
  },
  {
    id: 'guion',
    title: 'El guion',
    why: 'Lo que dirá la voz. Es lo que más decide si la gente se queda mirando.',
    prompt: `Quiero hacer un short vertical de unos 30 segundos sobre: [TU IDEA].

Escribe el guion en español, una frase por línea, en guion.txt:
- La primera frase es una pregunta que dé curiosidad.
- Después 3 o 4 datos sorprendentes, cada uno con una comparación de la vida diaria.
- La última frase invita a enviarle el video a alguien.

Muéstramelo y espera mi visto bueno antes de seguir.`,
    tips: [
      'Unas 75 palabras son 30 segundos.',
      'Funcionan las preguntas que todos se hicieron alguna vez: «¿por qué el mar es salado?», «¿qué pasa si cavas un túnel al centro de la Tierra?».',
      'Si algo no te gusta, díselo con tus palabras: «más corto», «la primera frase más intrigante».',
    ],
  },
  {
    id: 'voz',
    title: 'La voz',
    why: 'Convierte el guion en audio y anota en qué segundo se dice cada palabra, para sincronizar los subtítulos.',
    prompt: `Con el guion aprobado, genera la voz con edge-tts (voz es-MX-JorgeNeural, velocidad +8%).

Guarda el audio en voz.mp3 y un archivo palabras.json con el segundo exacto en que empieza cada palabra. Dime cuánto dura el audio.`,
    tips: [
      'Otras voces: es-MX-DaliaNeural, es-ES-AlvaroNeural, es-AR-TomasNeural, es-CO-GonzaloNeural.',
      'Si lee mal un número o una sigla, pídele que la escriba en letras en el guion («tres de» en vez de «3D»).',
    ],
  },
  {
    id: 'escena',
    title: 'La escena 3D y los subtítulos',
    why: 'La animación que se ve, hecha con Three.js en una página web.',
    prompt: `Haz un index.html con Three.js que dure lo mismo que voz.mp3:
- Una escena 3D sencilla, con formas y colores vivos, que cambie con cada frase del guion.
- Una cámara que siempre se mueva suave.
- Subtítulos grandes palabra por palabra en el centro, sincronizados con palabras.json.

Todo tiene que depender del tiempo y no de la velocidad del computador, para poder grabarlo cuadro por cuadro. Ábremelo en el navegador para verlo.`,
    tips: [
      'Pídele un estilo: «low poly», «neón», «colores pastel», «como dibujo animado».',
      'Deja libre el borde de abajo y el derecho: ahí van los botones de TikTok y Reels.',
      'Que algo cambie cada 2 segundos mantiene a la gente mirando.',
    ],
  },
  {
    id: 'grabar',
    title: 'Grabar y armar el video',
    why: 'Saca una foto por cada cuadro de la animación y la junta con la voz.',
    prompt: `Graba la animación cuadro por cuadro con Playwright a 1080x1920 y 30 fps (no grabes la pantalla) y une las imágenes con voz.mp3 usando ffmpeg en video.mp4.

Ábreme el video cuando esté listo y dime tres cosas que podría mejorar.`,
    tips: [
      'Tarda unos minutos. Grabar cuadro por cuadro hace que no se corte aunque tu computador sea lento.',
      'Si el video sale entrecortado o desfasado, pídele que revise que todo dependa del tiempo.',
    ],
  },
];

const ajustes = [
  'Pon los subtítulos más grandes y en amarillo.',
  'Agrega música suave de fondo, más baja que la voz.',
  'Haz que la cámara se acerque cuando digo el dato más sorprendente.',
  'Hazme una portada de 1080x1920 con el título en letras grandes.',
];

const todoEnUno = `Quiero hacer un short vertical en 3D (1080x1920, 30 fps, unos 30 segundos) sobre: [TU IDEA].

Hazlo tú todo dentro de esta carpeta y explícame cada paso en simple, sin palabras técnicas:

1. Revisa e instala lo que falte: Node.js, Python, edge-tts, Playwright y ffmpeg.
2. Escribe un guion corto en español: la primera frase es una pregunta que dé curiosidad y después 3 o 4 datos sorprendentes. Muéstramelo y espera mi visto bueno.
3. Genera la voz gratis con edge-tts (voz es-MX-JorgeNeural, velocidad +8%) y guarda en qué momento se dice cada palabra.
4. Haz un index.html con Three.js: una escena 3D sencilla con formas y colores vivos que cambie con cada frase, una cámara que se mueva suave y subtítulos grandes palabra por palabra en el centro de la pantalla.
5. Graba la animación cuadro por cuadro con Playwright (no grabes la pantalla) y une las imágenes con la voz usando ffmpeg en un archivo video.mp4.
6. Ábreme el video y dime tres cosas que podría mejorar.`;
---

<Page
  title="Tu primer short 3D con IA: Claude, ChatGPT, Gemini u OpenCode | Bryan López"
  description="Elige una app de IA de escritorio (Claude, ChatGPT, Antigravity de Google u OpenCode gratis) y copia un prompt por paso para hacer un short 3D con voz y subtítulos."
  current="tutoriales"
>
  <div class="wrap guide">
    <Breadcrumbs items={[
      { href: '/', label: 'Inicio' },
      { href: '/tutoriales/', label: 'Tutoriales' },
      { href: '/tutoriales/short-3d-con-ia/', label: 'Short 3D con IA' },
    ]} />

    <header class="guide-head">
      <div>
        <h1 class="page-title">Tu primer short 3D con IA</h1>
        <p class="section-lead">Eliges una app de IA (Claude, ChatGPT, Gemini u OpenCode) y copias un prompt por paso: la IA instala lo que falta, escribe el guion, pone la voz, arma la animación 3D con subtítulos y te entrega el .mp4.</p>
        <ul class="meta">
          <li><Icon name="clock" size={18} />15 min</li>
          <li><Icon name="desktop" size={18} />App de escritorio</li>
          <li><Icon name="student" size={18} />Principiante</li>
        </ul>
        <nav class="toc" aria-label="En esta guía">
          <a href="#antes">Elige tu app</a>
          {pasos.map((p, i) => <a href={`#${p.id}`}>{i + 1}. {p.title}</a>)}
          <a href="#ajustes">Ajustes</a>
          <a href="#prompt">Todo en un mensaje</a>
        </nav>
      </div>
      <figure class="tile sample">
        <Image src={ejemplo} alt="Portada de un short hecho así: ¿cuánto tardas en cruzar la Tierra?" widths={[300, 450, 600]} sizes="(max-width: 767px) 70vw, 300px" loading="eager" />
        <figcaption class="muted">Un short hecho con este método</figcaption>
      </figure>
    </header>

    <section class="section" id="antes" aria-labelledby="h-antes">
      <h2 class="section-title" id="h-antes">Elige tu app</h2>
      <p class="section-lead">Cualquiera de estas apps de escritorio sirve: todas pueden trabajar dentro de una carpeta de tu computador, instalar programas y crear archivos. No necesitas abrir PowerShell.</p>
      <ul class="apps">
        {apps.map((a) => (
          <li class="tile app" id={`app-${a.id}`}>
            <div class="app-head">
              <Icon name={a.icon} size={26} class="app-icon" />
              <div>
                <h3>{a.name}</h3>
                <p class="muted">{a.de}</p>
              </div>
              {a.recomendada && <span class="badge">Recomendada</span>}
            </div>
            <p class="price">{a.precio}</p>
            <p class="muted">{a.nota}</p>
            <p class="where"><Icon name="folder-open" size={18} />{a.donde}</p>
            <a class="ink-link" href={a.link.href} target="_blank" rel="noopener">Descargar en {a.link.label}</a>
          </li>
        ))}
      </ul>

      <h3 class="sub">Antes del primer prompt</h3>
      <ol class="setup">
        <li>Instala la app que elegiste e inicia sesión.</li>
        <li>Crea una carpeta vacía para tu video, por ejemplo <code>C:\videos\mi-primer-short</code>.</li>
        <li>En la app, abre esa carpeta (cada tarjeta de arriba dice dónde). Todo lo que haga la IA va a quedar ahí.</li>
      </ol>

      <h3 class="sub">Lo que la IA va a instalar por ti</h3>
      <div class="tools">
        {herramientas.map((h) => (
          <article class="tile tool">
            <Icon name={h.icon} size={26} class="tool-icon" />
            <div>
              <h4>{h.name}</h4>
              <p class="muted">{h.what}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" aria-labelledby="h-pasos">
      <h2 class="section-title" id="h-pasos">Un prompt por paso</h2>
      <p class="section-lead">Pega cada prompt en tu app, espera a que termine y revisa antes de pasar al siguiente. Cambia solo lo que está entre corchetes.</p>
      <ol class="steps">
        {pasos.map((p, i) => (
          <li class="tile step" id={p.id}>
            <div class="step-head">
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p class="muted">{p.why}</p>
              </div>
            </div>
            <div class="prompt">
              <div class="prompt-bar">
                <span>Prompt {i + 1}</span>
                <CopyButton target={`prompt-${p.id}`} what={`el prompt del paso ${p.title}`} label="Copiar prompt" />
              </div>
              <pre tabindex="0"><code id={`prompt-${p.id}`}>{p.prompt}</code></pre>
            </div>
            <div class="tips">
              <h4><Icon name="lightbulb" size={18} />Recomendaciones</h4>
              <ul>
                {p.tips.map((t) => <li>{t}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" id="ajustes" aria-labelledby="h-ajustes">
      <h2 class="section-title" id="h-ajustes">Ajustes</h2>
      <p class="section-lead">Cuando tengas el video, pide los cambios de a uno. Algunos que funcionan bien:</p>
      <ul class="tweaks">
        {ajustes.map((a, i) => (
          <li class="tile">
            <code id={`ajuste-${i}`}>{a}</code>
            <CopyButton target={`ajuste-${i}`} what={`el ajuste: ${a}`} />
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="prompt" aria-labelledby="h-prompt">
      <h2 class="section-title" id="h-prompt">Atajo: todo en un mensaje</h2>
      <p class="section-lead">Si prefieres no ir paso a paso, este prompt hace todo de una vez. Igual se detiene para que apruebes el guion.</p>
      <div class="tile prompt big">
        <div class="prompt-bar">
          <span>prompt.txt</span>
          <CopyButton target="prompt-text" what="el prompt completo" label="Copiar prompt" />
        </div>
        <pre tabindex="0"><code id="prompt-text">{todoEnUno}</code></pre>
      </div>
      <p class="note muted">Es un punto de partida. El que uso en mis videos agrega música, efectos de sonido y reglas para que la gente no deslice; lo comparto en el Discord.</p>
    </section>
  </div>

  <DiscordBand title="¿Algo no te funcionó?" text="Pásate por el Discord: ahí resolvemos errores de instalación, compartimos videos y dejo los prompts nuevos." />
</Page>

<style>
  .guide {
    padding-top: clamp(28px, 5vw, 56px);
  }

  .guide-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 40px;
    align-items: end;
    margin-top: 20px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin-top: 24px;
  }

  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-tile);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin-top: 24px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .toc a {
    color: var(--color-cyan-ink);
    text-underline-offset: 3px;
  }

  .sample {
    overflow: hidden;
  }

  .sample :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 40%;
  }

  .sample figcaption {
    padding: 12px 18px 14px;
    font-size: 0.9375rem;
  }

  h3 {
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  h4 {
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
  }

  code {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9em;
  }

  .setup {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 28px;
    padding-left: 1.4em;
    max-width: 760px;
  }

  .setup li::marker {
    font-weight: 700;
  }

  .setup > li > code {
    padding: 2px 8px;
    border-radius: 8px;
    background: var(--color-tile);
  }

  .cmd {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
    padding: 8px 8px 8px 16px;
    background: var(--color-tile);
    border-radius: 999px;
  }

  .cmd code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.875rem;
    scrollbar-width: thin;
  }

  .sub {
    margin-top: 48px;
  }

  .apps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .app {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .app-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: start;
  }

  .app-head :global(.app-icon) {
    color: var(--color-green-ink);
    margin-top: 2px;
  }

  .app-head p {
    font-size: 0.875rem;
  }

  .badge {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-size: 0.75rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .price {
    font-weight: 700;
  }

  .app > .muted {
    font-size: 0.9375rem;
  }

  .where {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    margin-top: auto;
    padding-top: 6px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .where :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--color-cyan-ink);
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
  }

  .tool {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    padding: 22px 24px;
  }

  .tool :global(.tool-icon) {
    color: var(--color-green-ink);
    margin-top: 2px;
  }

  .tool p {
    margin-top: 6px;
    font-size: 0.9375rem;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin-top: 32px;
    display: grid;
    gap: 16px;
  }

  .step {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-areas: 'head head' 'prompt tips';
    gap: 24px 32px;
    padding: clamp(24px, 3vw, 36px);
    scroll-margin-top: 96px;
  }

  .step-head {
    grid-area: head;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .step-head p {
    margin-top: 4px;
    max-width: 62ch;
  }

  .step-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .step .prompt {
    grid-area: prompt;
    min-width: 0;
    background: var(--color-bg);
    border-radius: var(--radius-media);
  }

  .prompt-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px 10px 20px;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .prompt pre {
    padding: 20px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .tips {
    grid-area: tips;
    align-self: start;
  }

  .tips h4 {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-green-ink);
    font-size: 1rem;
  }

  .tips ul {
    display: grid;
    gap: 10px;
    margin-top: 12px;
    padding-left: 1.1em;
    color: var(--color-muted);
    font-size: 0.9875rem;
  }

  .tweaks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 24px;
  }

  .tweaks li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 14px 14px 22px;
  }

  .tweaks code {
    min-width: 0;
    font-size: 0.9375rem;
  }

  .prompt.big {
    margin-top: 32px;
  }

  .big pre {
    padding: 24px;
    font-size: 0.9375rem;
  }

  .note {
    margin-top: 16px;
    max-width: 62ch;
  }

  @media (max-width: 1099px) {
    .tools,
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'prompt' 'tips';
    }
  }

  @media (max-width: 767px) {
    .guide-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }

    .sample {
      max-width: 320px;
    }

    .tools,
    .apps,
    .tweaks {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .tool {
      padding: 20px;
    }

    .step {
      padding: 20px;
    }

    .prompt pre {
      padding: 16px;
      font-size: 0.875rem;
    }
  }
</style>
