---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import TryDemos from '../components/TryDemos.astro';
import teamlobo from '../assets/projects/teamlobo.fit.png';
import superafit from '../assets/projects/superafit.com.png';
import shopya from '../assets/projects/shopya.com.ar.png';
import acordeavos from '../assets/projects/acordeavos.com.png';

const whatsapp =
  'https://wa.me/56994879144?text=' +
  encodeURIComponent('Hola Bryan, vi tu portafolio y quiero conversar sobre mi negocio.');
const email = 'bryanlopezdev@gmail.com';

const problems = [
  {
    title: 'No se ve bien en el celular',
    fix: 'Hay que hacer zoom para leer y los botones quedan chicos. Rehago la web para que se use cómoda desde el teléfono.',
  },
  {
    title: 'El navegador dice "No seguro"',
    fix: 'Falta el certificado https. Lo instalo y el aviso desaparece, que es justo cuando el cliente duda.',
  },
  {
    title: 'No se puede reservar ni pedir online',
    fix: 'Todo depende de que llamen. Agrego reservas, pedidos o inscripciones que funcionan las 24 horas.',
  },
  {
    title: 'Tarda en cargar',
    fix: 'Quien llega desde Google Maps se va si la página no abre rápido. La optimizo para que cargue en segundos.',
  },
];

const services: { icon: string; title: string; text: string; link?: { href: string; label: string } }[] = [
  {
    icon: 'browser',
    title: 'Páginas web',
    text: 'Rápidas, claras y hechas para el celular, con botón de WhatsApp y tu ficha de Google Maps.',
  },
  {
    icon: 'calendar-check',
    title: 'Apps y reservas online',
    text: 'Agenda de horas, inscripciones, pedidos, paneles de administración y pagos con Mercado Pago.',
  },
  {
    icon: 'storefront',
    title: 'Tiendas online',
    text: 'Catálogo, carrito y pagos para que vendas sin depender de un marketplace.',
  },
  {
    icon: 'sparkle',
    title: 'Un asistente con IA que atiende por ti',
    text: 'Responde a tus clientes por WhatsApp o en tu web a cualquier hora: precios, horarios, stock y reservas. Tú atiendes solo a quien ya está listo para comprar. En ShopYA hice uno que deja a cada vendedor actualizar productos y pedidos con solo escribirle.',
    link: { href: '#pruebalo', label: 'Pruébalo con un negocio de ejemplo.' },
  },
];

const automations = [
  { icon: 'whatsapp-logo', text: 'Avisos y recordatorios automáticos a tus clientes' },
  { icon: 'chat-circle-text', text: 'Formularios y leads directo a tu planilla o CRM' },
  { icon: 'file-text', text: 'Lectura y análisis automático de PDF' },
  { icon: 'flow-arrow', text: 'Tareas repetitivas que hoy haces a mano' },
];

const cases = [
  {
    id: 'teamlobo',
    name: 'TeamLobo',
    kind: 'Club de boxeo amateur en Arica',
    url: 'https://teamlobo.fit',
    host: 'teamlobo.fit',
    focus: 'left 40%',
    image: teamlobo,
    alt: 'Página de inicio de TeamLobo con el titular "Despierta el lobo en ti" y el botón para registrar una clase gratis',
    need: 'Necesitaban que la gente se inscribiera a su clase de prueba sin tener que llamar.',
    did: 'Hice la landing con registro de clase gratis, horarios, planes y botón de WhatsApp, más una plataforma para administrar a los alumnos.',
    stack: ['Next.js', 'Supabase', 'Tailwind CSS'],
  },
  {
    id: 'superafit',
    name: 'SuperaFit',
    kind: 'Plataforma para entrenadores y gimnasios',
    url: 'https://superafit.com',
    host: 'superafit.com',
    focus: 'left top',
    image: superafit,
    alt: 'Página de inicio de SuperaFit con el titular "Arma la rutina una vez" y un panel de alumnos de ejemplo',
    need: 'Los entrenadores armaban rutinas en planillas y no sabían si cada alumno las cumplía.',
    did: 'Diseñé y construí la plataforma completa: rutinas, planes, seguimiento de cada alumno e inicio de sesión con Google.',
    stack: ['Next.js', 'NestJS', 'Prisma', 'Google OAuth'],
  },
  {
    id: 'shopya',
    name: 'ShopYA',
    kind: 'Marketplace con más de 250 mil usuarios en Argentina',
    url: 'https://shopya.com.ar',
    host: 'shopya.com.ar',
    focus: 'center 30%',
    image: shopya,
    alt: 'Página de inicio de ShopYA con el anuncio "Crea tu tienda online" y sus planes',
    need: 'Miles de vendedores en una misma plataforma, cada uno con sus pagos, sus envíos y su propia tienda que administrar.',
    did: 'Como desarrollador full stack senior lideré pagos con Mercado Pago y envíos con OCA, Andreani y Correo Argentino. Hoy, como AI Engineer, construí la integración que permite administrar una tienda desde ChatGPT o Claude: productos, inventario, pedidos y precios con instrucciones en lenguaje natural.',
    stack: ['NestJS', 'Next.js', 'PostgreSQL', 'Mercado Pago', 'MCP', 'IA'],
  },
  {
    id: 'acordeavos',
    name: 'Acorde a Vos',
    kind: 'Tienda online de lencería en Argentina',
    url: 'https://acordeavos.com',
    host: 'acordeavos.com',
    focus: 'left top',
    image: acordeavos,
    alt: 'Página de inicio de Acorde a Vos con el titular "Lencería que te hace sentir increíble" y una foto de conjuntos',
    need: 'Vender en todo el país sin errores de precios, stock ni envíos al momento de pagar.',
    did: 'Desarrollé el checkout completo: carrito, lógica de precios, validación de pedidos e integración de pagos y envíos.',
    stack: ['React', 'Node.js', 'GCP'],
  },
];

const steps = [
  { title: 'Conversamos', text: 'Me cuentas por WhatsApp qué necesita tu negocio.' },
  { title: 'Propuesta', text: 'Te envío por escrito qué haré, en cuánto tiempo y cuánto cuesta.' },
  { title: 'Desarrollo', text: 'Te muestro avances para que opines antes de publicar.' },
  { title: 'Entrega', text: 'Publico todo, te enseño a usarlo y quedo disponible para ajustes.' },
];
---

<Base
  title="Desarrollo web y apps en Arica | Bryan López"
  description="Páginas web, apps de reservas, tiendas online, asistentes con IA y automatizaciones con n8n para negocios de Arica y todo Chile. Trato directo con el desarrollador."
>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="#inicio" aria-label="Bryan López, inicio">
        <span class="brand-mark" aria-hidden="true"><span class="c">&lt;</span>BL<span class="g">&gt;</span></span>
        <span class="brand-name">Bryan López</span>
      </a>
      <nav class="nav" aria-label="Secciones">
        <a href="#trabajos">Trabajos</a>
        <a href="#servicios">Servicios</a>
        <a href="#pruebalo">Pruébalo</a>
        <a href="#proceso">Proceso</a>
      </nav>
      <a class="btn btn-primary btn-sm" href={whatsapp} target="_blank" rel="noopener">
        <Icon name="whatsapp-logo" size={18} />Escríbeme
      </a>
    </div>
  </header>

  <main id="contenido">
    <section id="inicio" class="wrap bento" aria-label="Presentación">
      <div class="tile hero">
        <h1>Webs y apps que traen clientes</h1>
        <div>
          <p class="hero-sub">Desarrollo webs, reservas online y automatizaciones de WhatsApp para negocios de Arica y todo Chile. Trato directo conmigo.</p>
          <div class="hero-cta">
            <a class="btn btn-primary" href={whatsapp} target="_blank" rel="noopener">
              <Icon name="whatsapp-logo" size={20} />Escríbeme
            </a>
            <a class="btn btn-ghost" href="#trabajos">Ver trabajos</a>
          </div>
        </div>
      </div>

      {
        cases.slice(0, 3).map((c, i) => (
          <a class={`tile shot shot-${i + 1}`} href={`#${c.id}`} style={`--focus: ${c.focus}`}>
            <Image
              src={c.image}
              alt={c.alt}
              widths={[480, 720, 1080, 1440]}
              sizes={i === 0 ? '(max-width: 767px) 100vw, 50vw' : '(max-width: 767px) 100vw, 25vw'}
              loading="eager"
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
            <span class="cap">
              <strong>{c.name}</strong>
              <span>{c.kind}</span>
            </span>
          </a>
        ))
      }
    </section>

    <section class="section wrap" aria-labelledby="problemas-titulo">
      <h2 id="problemas-titulo" class="section-title">Lo que suele frenar a un negocio en internet</h2>
      <p class="section-lead">Son los problemas que más veo al revisar webs de negocios locales. Y tienen solución.</p>
      <ul class="problems">
        {
          problems.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.fix}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="servicios" class="section wrap" aria-labelledby="servicios-titulo">
      <h2 id="servicios-titulo" class="section-title">Qué hago</h2>
      <div class="services">
        <ul class="svc-list">
          {
            services.map((s) => (
              <li class="tile svc">
                <Icon name={s.icon} size={28} />
                <h3>{s.title}</h3>
                <p>
                  {s.text}
                  {s.link && (
                    <>
                      {' '}
                      <a class="svc-link" href={s.link.href}>{s.link.label}</a>
                    </>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
        <div class="tile auto">
          <Icon name="robot" size={34} />
          <h3>Automatización con n8n</h3>
          <p class="auto-lead">Conecto tus herramientas para que el trabajo repetitivo se haga solo.</p>
          <ul>
            {
              automations.map((a) => (
                <li>
                  <Icon name={a.icon} size={22} />
                  {a.text}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <TryDemos whatsapp={whatsapp} />

    <section id="trabajos" class="section wrap" aria-labelledby="trabajos-titulo">
      <h2 id="trabajos-titulo" class="section-title">Trabajos publicados</h2>
      <p class="section-lead">Proyectos en línea que puedes visitar ahora mismo.</p>
      <div class="cases">
        {
          cases.map((c) => (
            <article id={c.id} class="case">
              <a class="case-media" href={c.url} target="_blank" rel="noopener" aria-label={`Abrir ${c.host}`}>
                <Image src={c.image} alt={c.alt} widths={[640, 960, 1440]} sizes="(max-width: 899px) 100vw, 58vw" />
              </a>
              <div class="case-body">
                <h3>{c.name}</h3>
                <p class="case-kind">{c.kind}</p>
                <dl>
                  <dt>El desafío</dt>
                  <dd>{c.need}</dd>
                  <dt>Lo que hice</dt>
                  <dd>{c.did}</dd>
                </dl>
                <ul class="stack" aria-label="Tecnologías">
                  {c.stack.map((t) => <li>{t}</li>)}
                </ul>
                <a class="case-link" href={c.url} target="_blank" rel="noopener">
                  {c.host}
                  <Icon name="arrow-up-right" size={18} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section id="proceso" class="section wrap" aria-labelledby="proceso-titulo">
      <h2 id="proceso-titulo" class="section-title">Cómo trabajamos</h2>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-n" aria-hidden="true">{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section wrap" aria-labelledby="contacto-titulo">
      <div class="contact">
        <h2 id="contacto-titulo">¿Conversamos sobre tu negocio?</h2>
        <p>Cuéntame qué necesitas y te digo cómo lo haría y cuánto costaría, sin compromiso.</p>
        <div class="contact-cta">
          <a class="btn btn-primary" href={whatsapp} target="_blank" rel="noopener">
            <Icon name="whatsapp-logo" size={20} />Escríbeme
          </a>
          <a class="contact-mail" href={`mailto:${email}`}>
            <Icon name="envelope-simple" size={20} />{email}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <p>© {new Date().getFullYear()} Bryan López · Arica, Chile</p>
    <div class="foot-links">
      <a href="https://github.com/bl0pez" target="_blank" rel="noopener"><Icon name="github-logo" size={20} />GitHub</a>
      <a href="https://www.linkedin.com/in/bryan-lopez-sanchez" target="_blank" rel="noopener"><Icon name="linkedin-logo" size={20} />LinkedIn</a>
    </div>
  </footer>
</Base>

<style>
  /* Cabecera */
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--color-bg) 94%, transparent);
  }

  .top-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .brand-mark .c {
    color: var(--color-cyan);
  }

  .brand-mark .g {
    color: var(--color-green);
  }

  .nav {
    display: flex;
    gap: 26px;
  }

  .nav a {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 500;
    transition: color 200ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--color-ink);
    }
  }

  .btn-sm {
    padding: 11px 18px;
    font-size: 1rem;
  }

  /* Bento de portada */
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 16px;
    height: clamp(560px, calc(100svh - 104px), 780px);
    padding-top: 8px;
  }

  .tile {
    background: var(--color-tile);
    border-radius: var(--radius-tile);
    position: relative;
    overflow: hidden;
  }

  .hero {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    padding: clamp(28px, 3.4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }

  .hero h1 {
    font-weight: 800;
    font-size: clamp(2.75rem, 6.6vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    max-width: 11ch;
  }

  .hero-sub {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    color: var(--color-muted);
    max-width: 38ch;
  }

  .hero-cta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .shot {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-ink);
  }

  .shot :global(img) {
    flex: 1;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    object-position: var(--focus, left top);
    transition: transform 600ms var(--ease-out);
  }

  .shot-1 {
    grid-column: 3 / 5;
  }

  .cap {
    position: relative;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 10px;
    padding: 14px 20px 16px;
    background: var(--color-tile);
    line-height: 1.3;
  }

  .cap strong {
    font-weight: 700;
  }

  .cap span {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover :global(img) {
      transform: scale(1.03);
    }
  }

  /* El único momento de movimiento: las piezas del bento se asientan en orden al cargar. */
  @media (prefers-reduced-motion: no-preference) {
    .bento > .tile {
      animation: settle 700ms var(--ease-out) both;
    }

    .bento > .tile:nth-child(2) { animation-delay: 70ms; }
    .bento > .tile:nth-child(3) { animation-delay: 140ms; }
    .bento > .tile:nth-child(4) { animation-delay: 210ms; }
  }

  @keyframes settle {
    from {
      opacity: 0.35;
      transform: translateY(18px) scale(0.985);
      filter: blur(4px);
    }
  }

  /* Problemas */
  .problems {
    list-style: none;
    padding: 0;
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
  }

  .problems li {
    padding: 26px 0;
    border-top: 1px solid var(--color-line);
  }

  .problems h3 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .problems p {
    margin-top: 6px;
    color: var(--color-muted);
    max-width: 48ch;
  }

  /* Servicios */
  .services {
    margin-top: 44px;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 16px;
  }

  .svc-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 16px;
  }

  .svc {
    padding: 28px 30px;
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 18px;
    align-items: start;
  }

  .svc :global(svg) {
    grid-row: span 2;
    color: var(--color-green-ink);
    margin-top: 2px;
  }

  .svc h3 {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .svc p {
    margin-top: 6px;
    color: var(--color-muted);
  }

  .svc-link {
    color: var(--color-cyan-ink);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  .auto {
    background: var(--gradient-brand);
    color: var(--color-on-brand);
    padding: clamp(28px, 3vw, 40px);
    display: flex;
    flex-direction: column;
  }

  .auto h3 {
    margin-top: 18px;
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .auto-lead {
    margin-top: 10px;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .auto ul {
    list-style: none;
    padding: 0;
    margin-top: auto;
    padding-top: 28px;
    display: grid;
    gap: 14px;
    font-weight: 600;
  }

  .auto li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid color-mix(in oklab, var(--color-on-brand) 18%, transparent);
  }

  /* Casos */
  .cases {
    margin-top: 48px;
    display: grid;
    gap: clamp(48px, 6vw, 80px);
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  .case-media {
    display: block;
    border-radius: var(--radius-media);
    overflow: hidden;
    border: 1px solid var(--color-line);
    box-shadow: 0 18px 50px var(--color-shadow);
  }

  .case-media :global(img) {
    width: 100%;
    transition: transform 600ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .case-media:hover :global(img) {
      transform: scale(1.02);
    }
  }

  .case-body h3 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .case-kind {
    margin-top: 6px;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  .case-body dl {
    margin-top: 22px;
    display: grid;
    gap: 6px;
  }

  .case-body dt {
    font-weight: 700;
    font-size: 0.9375rem;
    margin-top: 10px;
  }

  .case-body dd {
    margin: 0;
    color: var(--color-muted);
  }

  .stack {
    list-style: none;
    padding: 0;
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .stack li {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--color-tile);
    border: 1px solid var(--color-line);
  }

  .case-link {
    margin-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    color: var(--color-cyan-ink);
    text-underline-offset: 4px;
  }

  /* Proceso */
  .steps {
    list-style: none;
    padding: 0;
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .step-n {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .steps h3 {
    margin-top: 16px;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .steps p {
    margin-top: 6px;
    color: var(--color-muted);
  }

  /* Contacto */
  .contact {
    background: var(--gradient-brand);
    color: var(--color-on-brand);
    border-radius: var(--radius-tile);
    padding: clamp(36px, 6vw, 80px);
  }

  .contact h2 {
    font-weight: 800;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .contact p {
    margin-top: 18px;
    font-size: 1.25rem;
    font-weight: 500;
    max-width: 44ch;
  }

  .contact-cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

