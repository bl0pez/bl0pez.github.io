---
import { Image } from 'astro:assets';
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
import GuideCard from '../components/GuideCard.astro';
import DiscordBand from '../components/DiscordBand.astro';
import { categorias, tutoriales, consejos } from '../data/tutoriales';
import ejemplo from '../assets/guias/short-3d-ejemplo.png';

const destacado = tutoriales[0];
---

<Page
  title="Tutoriales de IA en español | Bryan López"
  description="Aprende a crear videos, juegos y webs con inteligencia artificial. Tutoriales gratis en español, prompts listos para copiar y una comunidad en Discord."
  current="inicio"
>
  <section class="wrap bento" aria-label="Presentación">
    <div class="tile hero">
      <h1>Crea con IA, aunque nunca hayas programado</h1>
      <div>
        <p class="hero-sub">Tutoriales gratis y en español para hacer videos, juegos y webs con inteligencia artificial. Con las herramientas, los pasos y los prompts listos para copiar.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="/tutoriales/">Ver tutoriales</a>
          <a class="btn btn-ghost" href="#consejos">Consejos rápidos</a>
        </div>
      </div>
    </div>

    <a class="tile featured" href={`/tutoriales/${destacado.slug}/`}>
      <Image src={ejemplo} alt="Portada de un short 3D hecho con IA: ¿cuánto tardas en cruzar la Tierra?" widths={[360, 540, 720]} sizes="(max-width: 767px) 100vw, 25vw" loading="eager" fetchpriority="high" />
      <span class="cap">
        <strong>{destacado.title}</strong>
        <span>Así se ve un video hecho con esta guía</span>
      </span>
    </a>

    {categorias.slice(1, 3).map((c) => (
      <a class="tile mini" href={`/tutoriales/#${c.id}`}>
        <Icon name={c.icon} size={28} class="mini-icon" />
        <strong>{c.title}</strong>
        <span class="muted">{c.tutoriales.length ? `${c.tutoriales.length} guías` : 'Próximamente'}</span>
      </a>
    ))}
  </section>

  <section class="wrap section" aria-labelledby="h-nuevos">
    <h2 class="section-title" id="h-nuevos">Tutoriales nuevos</h2>
    <p class="section-lead">Cada guía dice qué instalar, en qué orden y qué escribirle a la IA. Si algo falla, lo resolvemos en el Discord.</p>
    <div class="guides">
      {tutoriales.slice(0, 6).map((t) => <GuideCard tutorial={t} categoria={t.categoria.title} />)}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="h-temas">
    <h2 class="section-title" id="h-temas">Temas</h2>
    <ul class="topics">
      {categorias.map((c) => (
        <li>
          <a class="tile topic" href={`/tutoriales/#${c.id}`}>
            <Icon name={c.icon} size={28} class="topic-icon" />
            <span class="topic-body">
              <strong>{c.title}</strong>
              <span class="muted">{c.text}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section" id="consejos" aria-labelledby="h-consejos">
    <h2 class="section-title" id="h-consejos">Consejos para pedirle cosas a la IA</h2>
    <p class="section-lead">Sirven para Claude, ChatGPT o la que uses. Son los que más me han ahorrado tiempo haciendo videos.</p>
    <ol class="tips">
      {consejos.map((c) => (
        <li>
          <h3>{c.title}</h3>
          <p class="muted">{c.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <DiscordBand title="Aprende con otros" text="Comparte lo que hiciste, pregunta cuando te trabes y entérate primero de los tutoriales nuevos." />
</Page>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 16px;
    height: clamp(560px, calc(100svh - 104px), 760px);
    padding-top: 8px;
  }

  .bento > .tile {
    position: relative;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bento > .tile {
      animation: settle 700ms var(--ease-out) both;
    }

    .bento > .tile:nth-child(2) { animation-delay: 70ms; }
    .bento > .tile:nth-child(3) { animation-delay: 140ms; }
    .bento > .tile:nth-child(4) { animation-delay: 210ms; }
  }

  @keyframes settle {
    from {
      opacity: 0.35;
      transform: translateY(18px) scale(0.985);
      filter: blur(4px);
    }
  }

  .hero {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    padding: clamp(28px, 3.4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
  }

  .hero h1 {
    font-weight: 800;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    max-width: 12ch;
  }

  .hero-sub {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    color: var(--color-muted);
    max-width: 40ch;
  }

  .hero-cta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .featured {
    grid-column: 3 / 4;
    grid-row: 1 / 3;
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .featured :global(img) {
    flex: 1;
    min-height: 0;
    width: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 600ms var(--ease-out);
  }

  .cap {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 20px 16px;
    background: var(--color-tile);
    line-height: 1.3;
  }

  .cap strong {
    font-weight: 700;
  }

  .cap span {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .mini {
    grid-column: 4 / 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: 26px;
    text-decoration: none;
  }

  .mini :global(.mini-icon) {
    color: var(--color-green-ink);
    margin-bottom: auto;
  }

  .mini strong {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  @media (hover: hover) and (pointer: fine) {
    .featured:hover :global(img) {
      transform: scale(1.03);
    }

    .topic:hover,
    .mini:hover {
      outline: 1px solid var(--color-ink);
    }
  }

  .guides {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .topics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .topic {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    height: 100%;
    padding: 28px 30px;
    text-decoration: none;
  }

  .topic :global(.topic-icon) {
    color: var(--color-green-ink);
    margin-top: 2px;
  }

  .topic-body {
    display: grid;
    gap: 6px;
  }

  .topic strong {
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .tips {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 56px;
    margin-top: 24px;
    counter-reset: tip;
  }

  .tips li {
    display: grid;
    gap: 8px;
    padding-block: 24px;
    border-top: 1px solid var(--color-line);
    counter-increment: tip;
  }

  .tips h3 {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .tips h3::before {
    content: counter(tip) / '';
    color: var(--color-cyan-ink);
    font-variant-numeric: tabular-nums;
  }

  .tips p {
    max-width: 48ch;
  }

  @media (max-width: 1099px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      height: auto;
    }

    .hero {
      grid-column: 1 / 3;
      grid-row: auto;
      min-height: 440px;
    }

    .featured {
      grid-column: 1 / 2;
      grid-row: span 2;
      aspect-ratio: 9 / 13;
    }

    .mini {
      grid-column: 2 / 3;
    }

    .topics,
    .tips {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 767px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .hero,
    .featured,
    .mini {
      grid-column: auto;
      grid-row: auto;
    }

    .hero {
      min-height: 0;
    }

    .hero-cta .btn {
      flex: 1;
      justify-content: center;
    }

    .featured {
      aspect-ratio: 4 / 5;
    }

    .mini {
      min-height: 150px;
    }

    .topic {
      padding: 24px;
    }
  }
</style>
