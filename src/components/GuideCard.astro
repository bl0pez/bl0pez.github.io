---
// Tarjeta de una guía: todo el bloque es un solo destino, así que un enlace envuelve el <article>.
import Icon from './Icon.astro';
import type { Tutorial } from '../data/tutoriales';

interface Props {
  tutorial: Tutorial;
  categoria?: string;
}

const { tutorial: t, categoria } = Astro.props;
---

<a class="guide-link" href={`/tutoriales/${t.slug}/`}>
  <article class="guide">
    <h3>{t.title}</h3>
    <p class="muted">{t.summary}</p>
    <footer>
      {categoria && <span>{categoria}</span>}
      <span>{t.nivel}</span>
      <span>{t.minutes} min</span>
      <span class="go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
    </footer>
  </article>
</a>

<style>
  .guide-link {
    display: block;
    text-decoration: none;
    border-radius: var(--radius-media);
  }

  .guide {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 20px 22px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-media);
    background: var(--color-tile);
    transition: border-color 200ms ease;
  }

  h3 {
    font-weight: 700;
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-top: 4px;
    color: var(--color-cyan-ink);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .go {
    display: inline-flex;
    margin-left: auto;
  }

  @media (hover: hover) and (pointer: fine) {
    .guide-link:hover .guide {
      border-color: var(--color-ink);
    }
  }
</style>
