---
// Sección "Pruébalo": tres demos con IA sobre negocios ficticios.
// El marcado es estático; la lógica (pestañas, chat, agenda, redes) vive en el script de abajo.
import Icon from './Icon.astro';

interface Props {
  whatsapp: string;
}

const { whatsapp } = Astro.props;
const apiUrl = (import.meta.env.PUBLIC_API_URL as string | undefined) || 'https://api.blopezdev.com';
const siteKey = '0x4AAAAAAFUZlAgSAQsFX5k2';

const rubros = [
  {
    id: 'gimnasio',
    label: 'Gimnasio',
    name: 'Lobo Fit',
    negocio: 'Lobo Fit',
    objetivo: 'Llenar las clases de la mañana',
    chat: ['¿Qué planes tienen y cuánto cuestan?', '¿A qué hora abren los sábados?', '¿Puedo hacer una clase de prueba?'],
    agenda: ['Quiero agendar una clase de prueba mañana', '¿Qué horarios hay el viernes en la tarde?', 'Quiero reservar para el lunes temprano'],
  },
  {
    id: 'dental',
    label: 'Clínica dental',
    name: 'Clínica Sonríe',
    negocio: 'Clínica Sonríe',
    objetivo: 'Conseguir más pacientes para limpiezas dentales',
    chat: ['¿Cuánto cuesta una limpieza dental?', '¿Atienden urgencias?', '¿Trabajan con Fonasa o isapre?'],
    agenda: ['Quiero una hora para una limpieza dental', '¿Tienen horas el jueves en la tarde?', 'Necesito una evaluación para mi hijo'],
  },
  {
    id: 'restaurante',
    label: 'Restaurante',
    name: 'Sabor Ariqueño',
    negocio: 'Sabor Ariqueño',
    objetivo: 'Llenar el local los martes y miércoles',
    chat: ['¿Cuál es el menú del día?', '¿Tienen opciones vegetarianas?', '¿Hacen delivery?'],
    agenda: ['Quiero una mesa para 4 personas mañana', '¿Hay mesa para 2 el sábado a las 21:00?', 'Quiero reservar para un cumpleaños'],
  },
];

const tabs = [
  { id: 'chat', label: 'Atención al cliente', icon: 'chat-circle-text' },
  { id: 'agenda', label: 'Agenda de horas', icon: 'calendar-check' },
  { id: 'social', label: 'Redes sociales', icon: 'share-network' },
];

const chatModes = [
  { id: 'chat', hint: 'Pregunta lo que te preguntaría un cliente. Elige una de estas o escribe la tuya.' },
  { id: 'agenda', hint: 'Pide una hora como lo haría un cliente. Cuando quede agendada, verás la confirmación aquí.' },
];

const icons = ['instagram-logo', 'facebook-logo', 'copy', 'check', 'image', 'calendar-check', 'warning', 'whatsapp-logo', 'hash'];

const config = {
  apiUrl,
  siteKey,
  whatsapp,
  rubros: Object.fromEntries(rubros.map((r) => [r.id, r])),
};
---

<section id="pruebalo" class="section wrap try" aria-labelledby="pruebalo-titulo" data-try>
  <h2 id="pruebalo-titulo" class="section-title">Pruébalo con un negocio de ejemplo</h2>
  <p class="section-lead">
    Habla con un asistente, agenda una hora o arma la semana de publicaciones. Los tres negocios son ficticios. En el
    tuyo, el asistente respondería con tus precios y tus horarios mientras tú trabajas.
  </p>

  <div class="try-tile">
    <div class="try-tabs" role="tablist" aria-label="Demos con IA" aria-orientation="horizontal">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            class="try-tab"
            id={`try-tab-${t.id}`}
            aria-controls={`try-panel-${t.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={t.id}
          >
            <Icon name={t.icon} size={22} />
            <span>{t.label}</span>
          </button>
        ))
      }
    </div>

    {
      chatModes.map((m, i) => (
        <div
          class="try-panel"
          role="tabpanel"
          id={`try-panel-${m.id}`}
          aria-labelledby={`try-tab-${m.id}`}
          data-mode={m.id}
          data-hint={m.hint}
          hidden={i !== 0}
        >
          <div class="try-rubros" role="group" aria-label="Tipo de negocio">
            {rubros.map((r, j) => (
              <button type="button" class="try-chip" data-rubro={r.id} aria-pressed={j === 0 ? 'true' : 'false'}>
                {r.label}
              </button>
            ))}
          </div>

          <div class="try-chat">
            <div class="try-chat-head">
              <span class="try-avatar" aria-hidden="true" data-avatar>L</span>
              <strong data-biz>Lobo Fit</strong>
              <span class="try-demo-tag">Demo</span>
            </div>
            <div class="try-log" data-log aria-live="polite" aria-label="Conversación" tabindex="0" />
            <form class="try-composer" data-form autocomplete="off">
              <label class="try-sr" for={`try-input-${m.id}`}>Tu mensaje</label>
              <div class="try-input-wrap">
                <input
                  id={`try-input-${m.id}`}
                  class="try-input"
                  type="text"
                  maxlength="500"
                  placeholder="Escribe tu mensaje"
                  enterkeyhint="send"
                  data-input
                />
                <span class="try-count try-count-chat" data-count aria-live="off" hidden />
              </div>
              <button type="submit" class="btn btn-primary try-send" data-send aria-label="Enviar mensaje">
                <Icon name="paper-plane-right" size={20} />
                <span class="try-send-label">Enviar</span>
              </button>
            </form>
          </div>
          <p class="try-note">Negocio ficticio: los precios, horarios y reservas son inventados para esta demostración.</p>
        </div>
      ))
    }

    <div class="try-panel" role="tabpanel" id="try-panel-social" aria-labelledby="try-tab-social" data-mode="social" hidden>
      <div class="try-social">
        <form class="try-form" data-social-form novalidate>
          <div class="try-field">
            <label for="try-s-rubro">Tipo de negocio</label>
            <div class="try-select">
              <select id="try-s-rubro" data-s-rubro>
                {rubros.map((r) => <option value={r.id}>{r.label}</option>)}
              </select>
              <Icon name="caret-down" size={18} />
            </div>
          </div>
          <div class="try-field">
            <label for="try-s-negocio">Nombre del negocio</label>
            <input id="try-s-negocio" class="try-text" type="text" maxlength="60" value="Lobo Fit" data-s-negocio />
          </div>
          <div class="try-field">
            <div class="try-label-row">
              <label for="try-s-objetivo">Objetivo de la semana</label>
              <span class="try-count" data-s-count aria-live="off">0/200</span>
            </div>
            <textarea
              id="try-s-objetivo"
              class="try-text"
              rows="3"
              maxlength="200"
              placeholder="Llenar las clases de la mañana"
              data-s-objetivo></textarea>
          </div>
          <p class="try-error" role="alert" data-s-error hidden></p>
          <button type="submit" class="btn btn-primary try-submit" data-s-submit>
            <Icon name="sparkle" size={20} />Generar publicaciones
          </button>
          <p class="try-note">Negocio ficticio. Puedes cambiar el nombre y el objetivo para ver cómo se adapta.</p>
        </form>

        <div class="try-results" data-s-results aria-live="polite" aria-label="Publicaciones generadas">
          <div class="try-empty" data-s-empty>
            <p>Aquí aparecerán cinco publicaciones para la semana, con día, hora, texto, hashtags e idea de imagen. Cada una se copia con un toque.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="try-ts-hint" data-ts-hint hidden>Confirma que eres una persona marcando la casilla y la demo sigue sola.</p>
  <div class="try-ts" data-ts-box></div>

  <template data-icons>
    {icons.map((n) => <span data-icon={n}><Icon name={n} size={20} /></span>)}
  </template>

  <script type="application/json" is:inline data-config set:html={JSON.stringify(config)} />
</section>

<style is:global>
  .try [hidden] {
    display: none !important;
  }

  .try-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .try-ico {
    display: inline-flex;
    flex: none;
  }

  .try-ico svg {
    width: 1.25em;
    height: 1.25em;
  }

  /* Turnstile en modo "solo si hace falta": no ocupa espacio salvo cuando pide marcar la casilla. */
  .try-ts {
    display: flex;
    justify-content: center;
  }

  .try-ts:has(iframe) {
    margin-top: 16px;
  }

  .try-ts-hint {
    margin-top: 20px;
    text-align: center;
    font-weight: 600;
    color: var(--color-ink);
  }

  .try-tile {
    margin-top: 40px;
    background: var(--color-tile);
    border-radius: var(--radius-tile);
    overflow: hidden;
  }

  /* Pestañas */
  .try-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--color-line);
  }

  .try-tab {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 68px;
    padding: 12px 6px;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    color: var(--color-muted);
    background: transparent;
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition: color 200ms ease;
  }

  .try-tab::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -1px;
    height: 3px;
    border-radius: 999px;
    background: var(--gradient-brand);
    transform: scaleX(0);
    transition: transform 240ms var(--ease-out);
  }

  .try-tab[aria-selected='true'] {
    color: var(--color-ink);
  }

  .try-tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .try-tab:focus-visible {
    outline-offset: -3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .try-tab:hover {
      color: var(--color-ink);
    }
  }

  @media (min-width: 640px) {
    .try-tab {
      flex-direction: row;
      gap: 10px;
      font-size: 1rem;
      min-height: 64px;
    }
  }

  .try-panel {
    padding: clamp(16px, 3vw, 32px);
  }

  /* Selector de negocio */
  .try-rubros {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .try-chip {
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.2;
    min-height: 44px;
    padding: 10px 16px;
    color: var(--color-ink);
    background: transparent;
    border: 1.5px solid var(--color-line);
    border-radius: 999px;
    cursor: pointer;
    transition: transform 160ms var(--ease-out), background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }

  .try-chip:active {
    transform: scale(0.97);
  }

  .try-chip[aria-pressed='true'] {
    background: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-bg);
  }

  .try-chip:disabled:not([aria-pressed='true']) {
    opacity: 0.55;
    cursor: not-allowed;
  }

  @media (hover: hover) and (pointer: fine) {
    .try-chip:not([aria-pressed='true']):not(:disabled):hover {
      border-color: var(--color-ink);
    }
  }

  /* Chat */
  .try-chat {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    height: clamp(400px, 60svh, 480px);
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .try-chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    background: var(--color-tile);
    border-bottom: 1px solid var(--color-line);
  }

  .try-avatar {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 999px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-weight: 700;
  }

  .try-chat-head strong {
    font-weight: 700;
    letter-spacing: -0.01em;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .try-demo-tag {
    flex: none;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    padding: 5px 10px;
    border-radius: 999px;
    color: var(--color-cyan-ink);
    border: 1.5px solid var(--color-cyan-ink);
  }

  .try-log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
  }

  .try-log:focus-visible {
    outline-offset: -3px;
  }

  .try-msg {
    max-width: min(86%, 46ch);
    padding: 10px 14px;
    border-radius: var(--radius-media);
    line-height: 1.45;
    overflow-wrap: anywhere;
    white-space: pre-wrap;
  }

  .try-msg-bot {
    align-self: flex-start;
    background: var(--color-tile);
    border: 1px solid var(--color-line);
    border-bottom-left-radius: 4px;
  }

  .try-msg-user {
    align-self: flex-end;
    background: var(--gradient-brand);
    color: var(--color-on-brand);
    font-weight: 500;
    border-bottom-right-radius: 4px;
  }

  .try-typing {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .try-dots {
    display: inline-flex;
    gap: 3px;
  }

  .try-dots i {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .try-msg,
    .try-card,
    .try-post {
      animation: try-in 240ms var(--ease-out) both;
    }

    .try-dots i {
      animation: try-dot 1.1s ease-in-out infinite;
    }

    .try-dots i:nth-child(2) {
      animation-delay: 150ms;
    }

    .try-dots i:nth-child(3) {
      animation-delay: 300ms;
    }

    .try-skeleton {
      animation: try-pulse 1.4s ease-in-out infinite;
    }
  }

  @keyframes try-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes try-dot {
    0%,
    80%,
    100% {
      opacity: 0.3;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes try-pulse {
    50% {
      opacity: 0.55;
    }
  }

  /* Estado inicial con sugerencias */
  .try-empty {
    margin: auto 0;
    padding: 8px 0;
    color: var(--color-muted);
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 16px;
  }

  .try-empty p {
    max-width: 42ch;
  }

  .try-suggest {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .try-suggest .try-chip {
    background: var(--color-tile);
    text-align: left;
  }

  /* Tarjeta de reserva */
  .try-card {
    align-self: flex-start;
    width: min(100%, 360px);
    padding: 16px 18px;
    background: var(--color-tile);
    border: 1.5px solid var(--color-green-ink);
    border-radius: var(--radius-media);
  }

  .try-card h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-green-ink);
  }

  .try-card dl {
    margin-top: 12px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
  }

  .try-card dt {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .try-card dd {
    margin: 0;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .try-card .try-code {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .try-card p {
    margin-top: 12px;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  /* Avisos y errores */
  .try-notice {
    align-self: stretch;
    display: grid;
    gap: 12px;
    justify-items: start;
    padding: 12px 14px;
    border-radius: var(--radius-media);
    background: var(--color-tile);
    border: 1px solid var(--color-line);
    font-size: 0.9375rem;
  }

  .try-notice p {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .try-notice-error {
    background: var(--color-error-bg);
    color: var(--color-error-ink);
    border-color: color-mix(in oklab, var(--color-error-ink) 35%, transparent);
  }

  .try-notice-ok {
    color: var(--color-green-ink);
    border-color: var(--color-green-ink);
  }

  .try-cta {
    padding: 11px 18px;
    font-size: 1rem;
  }

  .try-notice-error .try-cta {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  /* Compositor */
  .try-composer {
    display: flex;
    gap: 8px;
    padding: 10px;
    background: var(--color-tile);
    border-top: 1px solid var(--color-line);
  }

  .try-input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .try-input,
  .try-text {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1.5px solid var(--color-line);
    transition: border-color 200ms ease;
  }

  .try-input {
    height: 48px;
    padding: 0 16px;
    border-radius: 999px;
  }

  .try-input:has(+ .try-count:not([hidden])) {
    padding-right: 64px;
  }

  .try-input::placeholder,
  .try-text::placeholder {
    color: var(--color-muted);
    opacity: 0.85;
  }

  .try-input:focus-visible,
  .try-text:focus-visible {
    outline-offset: 1px;
    border-color: var(--color-cyan-ink);
  }

  .try-count {
    font-size: 0.875rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .try-count-chat {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .try-count.is-near {
    color: var(--color-error-ink);
    font-weight: 600;
  }

  .try-send {
    flex: none;
    height: 48px;
    padding: 0 20px;
    justify-content: center;
  }

  .try-send:disabled,
  .try-submit:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  @media (max-width: 479px) {
    .try-send {
      width: 48px;
      padding: 0;
    }

    .try-send-label {
      display: none;
    }
  }

  .try-note {
    margin-top: 14px;
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  /* Redes sociales */
  .try-social {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  @media (min-width: 960px) {
    .try-social {
      grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
      gap: 40px;
    }
  }

  .try-form {
    display: grid;
    gap: 18px;
  }

  .try-field {
    display: grid;
    gap: 8px;
    min-width: 0;
  }

  .try-field label {
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .try-label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .try-text {
    min-height: 48px;
    padding: 12px 14px;
    border-radius: var(--radius-media);
  }

  textarea.try-text {
    resize: vertical;
    line-height: 1.45;
  }

  .try-select {
    position: relative;
  }

  .try-select select {
    appearance: none;
    width: 100%;
    min-height: 48px;
    padding: 12px 44px 12px 14px;
    font: inherit;
    font-size: 1rem;
    color: var(--color-ink);
    background: var(--color-bg);
    border: 1.5px solid var(--color-line);
    border-radius: var(--radius-media);
    cursor: pointer;
  }

  .try-select select:focus-visible {
    outline-offset: 1px;
    border-color: var(--color-cyan-ink);
  }

  .try-select .try-ico,
  .try-select > svg {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-muted);
  }

  .try-error {
    padding: 10px 14px;
    border-radius: var(--radius-media);
    background: var(--color-error-bg);
    color: var(--color-error-ink);
    font-size: 0.9375rem;
  }

  .try-submit {
    justify-content: center;
    white-space: normal;
  }

  .try-results {
    display: grid;
    gap: 12px;
    min-width: 0;
  }

  .try-results > .try-empty {
    margin: 0;
    padding: 32px 20px;
    background: var(--color-bg);
    border: 1.5px dashed var(--color-line);
    border-radius: var(--radius-media);
  }

  .try-results .try-notice {
    justify-items: start;
  }

  .try-post {
    display: grid;
    gap: 12px;
    padding: 18px 20px;
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-media);
    min-width: 0;
  }

  .try-post-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    flex-wrap: wrap;
  }

  .try-post-head .try-ico {
    color: var(--color-cyan-ink);
  }

  .try-post-when {
    color: var(--color-muted);
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .try-post-text {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .try-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-cyan-ink);
    font-weight: 600;
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  .try-idea {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .try-idea .try-ico {
    margin-top: 2px;
  }

  .try-post-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .try-copy {
    padding: 10px 16px;
    min-height: 44px;
    font-size: 0.9375rem;
  }

  .try-copy-msg {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .try-skeleton {
    height: 150px;
    border-radius: var(--radius-media);
    background: var(--color-line);
    opacity: 0.45;
  }

  .try-loading {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
</style>

<script>
  type Rubro = 'gimnasio' | 'dental' | 'restaurante';
  type Role = 'user' | 'assistant';
  interface Msg {
    role: Role;
    content: string;
  }
  interface Reserva {
    codigo: string;
    nombre: string;
    slotId: string;
    servicio: string;
    fecha: string;
    hora: string;
  }
  interface AgendaRes {
    reply: string;
    reserva: Reserva | null;
    cancelada: string | null;
  }
  interface Post {
    dia: string;
    hora: string;
    red: 'instagram' | 'facebook';
    texto: string;
    hashtags: string[];
    ideaImagen: string;
  }
  interface RubroCfg {
    id: Rubro;
    label: string;
    name: string;
    negocio: string;
    objetivo: string;
    chat: string[];
    agenda: string[];
  }
  interface Config {
    apiUrl: string;
    siteKey: string;
    whatsapp: string;
    rubros: Record<Rubro, RubroCfg>;
  }
  interface TurnstileApi {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id?: string) => void;
  }

  const root = document.querySelector<HTMLElement>('[data-try]');

  if (root) {
    const config: Config = JSON.parse(root.querySelector('[data-config]')!.textContent || '{}');
    const API = config.apiUrl.replace(/\/$/, '');
    const MAX_USER = 500;
    const MAX_MSGS = 12;
    const COOLDOWN = 2000;

    /* ---------- Errores ---------- */
    class ApiError extends Error {
      status: number;
      cta: boolean;
      constructor(status: number, message: string, cta = false) {
        super(message);
        this.status = status;
        this.cta = cta || status === 429;
      }
    }

    const MSG_TURNSTILE =
      'No pude verificar que eres una persona. Recarga la página o escríbeme y probamos la demo juntos por WhatsApp.';
    const MSG_NETWORK = 'La demo no está disponible en este momento. Intenta de nuevo en unos minutos.';

    /* ---------- Iconos clonados desde el template ---------- */
    const iconTpl = root.querySelector<HTMLTemplateElement>('template[data-icons]')!;
    function icon(name: string): HTMLElement {
      const src = iconTpl.content.querySelector(`[data-icon="${name}"]`);
      const span = document.createElement('span');
      span.className = 'try-ico';
      span.setAttribute('aria-hidden', 'true');
      if (src) span.innerHTML = src.innerHTML;
      return span;
    }

    /* ---------- Turnstile (se carga en la primera interacción) ---------- */
    const tsBox = root.querySelector<HTMLElement>('[data-ts-box]')!;
    const tsHint = root.querySelector<HTMLElement>('[data-ts-hint]')!;
    const tsWin = window as unknown as { turnstile?: TurnstileApi };
    let scriptPromise: Promise<void> | null = null;
    let widgetId: string | undefined;
    let readyToken: string | null = null;
    let waiter: { resolve: (t: string) => void; reject: (e: Error) => void } | null = null;
    let needsReset = false;

    function loadScript(): Promise<void> {
      if (scriptPromise) return scriptPromise;
      scriptPromise = new Promise<void>((resolve, reject) => {
        const s = document.createElement('script');
        s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        s.async = true;
        s.onload = () => resolve();
        s.onerror = () => {
          scriptPromise = null;
          reject(new ApiError(0, MSG_TURNSTILE, true));
        };
        document.head.appendChild(s);
      });
      return scriptPromise;
    }

    async function ensureWidget(): Promise<void> {
      await loadScript();
      if (widgetId !== undefined) return;
      if (!tsWin.turnstile) throw new ApiError(0, MSG_TURNSTILE, true);
      widgetId = tsWin.turnstile.render(tsBox, {
        sitekey: config.siteKey,
        appearance: 'interaction-only',
        language: 'es',
        callback: (token: string) => {
          if (waiter) {
            const w = waiter;
            waiter = null;
            needsReset = true;
            w.resolve(token);
          } else {
            readyToken = token;
          }
        },
        'expired-callback': () => {
          readyToken = null;
        },
        'error-callback': () => {
          readyToken = null;
          needsReset = true;
          if (waiter) {
            const w = waiter;
            waiter = null;
            w.reject(new ApiError(0, MSG_TURNSTILE, true));
          }
        },
        // Si Cloudflare pide marcar la casilla, damos tiempo; si no, cortamos rápido.
        'before-interactive-callback': () => {
          extendWait?.();
          tsHint.hidden = false;
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          tsBox.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
        },
        'after-interactive-callback': () => {
          tsHint.hidden = true;
        },
      });
    }

    let extendWait: (() => void) | null = null;

    async function takeToken(): Promise<string> {
      await ensureWidget();
      if (readyToken) {
        const t = readyToken;
        readyToken = null;
        needsReset = true;
        return t;
      }
      return new Promise<string>((resolve, reject) => {
        const fail = () => {
          waiter = null;
          extendWait = null;
          needsReset = true;
          reject(new ApiError(0, MSG_TURNSTILE, true));
        };
        // 15 s para la verificación invisible; 2 minutos si aparece la casilla.
        let timer = window.setTimeout(fail, 15000);
        extendWait = () => {
          clearTimeout(timer);
          timer = window.setTimeout(fail, 120000);
        };
        waiter = {
          resolve: (t) => {
            clearTimeout(timer);
            extendWait = null;
            resolve(t);
          },
          reject: (e) => {
            clearTimeout(timer);
            extendWait = null;
            reject(e);
          },
        };
        if (needsReset && widgetId !== undefined) {
          needsReset = false;
          tsWin.turnstile!.reset(widgetId);
        }
      });
    }

    let primed = false;
    function prime() {
      if (primed) return;
      primed = true;
      ensureWidget().catch(() => {
        primed = false;
      });
    }
    ['focusin', 'pointerdown', 'keydown'].forEach((ev) => root.addEventListener(ev, prime, { once: false, passive: true }));

    /* ---------- Sesión y peticiones ---------- */
    let session: { token: string; exp: number } | null = null;
    let sessionInflight: Promise<string> | null = null;

    function parseExp(v: unknown): number {
      if (typeof v === 'number') return v < 1e12 ? v * 1000 : v;
      const t = Date.parse(String(v));
      return Number.isNaN(t) ? Date.now() + 25 * 60 * 1000 : t;
    }

    function getSession(): Promise<string> {
      if (session && session.exp - Date.now() > 30000) return Promise.resolve(session.token);
      if (sessionInflight) return sessionInflight;
      sessionInflight = (async () => {
        try {
          const turnstileToken = await takeToken();
          const data = await post<{ token: string; expiresAt: unknown }>('/session', { turnstileToken }, false);
          session = { token: data.token, exp: parseExp(data.expiresAt) };
          return data.token;
        } catch (e) {
          if (e instanceof ApiError && e.status === 403) throw new ApiError(403, e.message, true);
          throw e;
        } finally {
          sessionInflight = null;
        }
      })();
      return sessionInflight;
    }

    async function post<T>(path: string, body: unknown, auth = true, retried = false): Promise<T> {
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (auth) headers.Authorization = `Bearer ${await getSession()}`;
      let res: Response;
      try {
        res = await fetch(API + path, { method: 'POST', headers, body: JSON.stringify(body) });
      } catch {
        throw new ApiError(0, MSG_NETWORK);
      }
      const data = (await res.json().catch(() => null)) as { error?: string } | null;
      if (res.status === 401 && auth && !retried) {
        session = null;
        return post<T>(path, body, auth, true);
      }
      if (!res.ok) throw new ApiError(res.status, data?.error || MSG_NETWORK);
      return data as T;
    }

    /* ---------- Utilidades de interfaz ---------- */
    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string): HTMLElementTagNameMap[K] {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined) n.textContent = text;
      return n;
    }

    function waCta(): HTMLAnchorElement {
      const a = el('a', 'btn btn-primary try-cta');
      a.href = config.whatsapp;
      a.target = '_blank';
      a.rel = 'noopener';
      a.append(icon('whatsapp-logo'), document.createTextNode('Escríbeme'));
      return a;
    }

    function noticeError(err: unknown): HTMLElement {
      const e = err instanceof ApiError ? err : new ApiError(0, MSG_NETWORK);
      const box = el('div', 'try-notice try-notice-error');
      const p = el('p');
      p.append(icon('warning'), el('span', undefined, e.message));
      box.append(p);
      if (e.cta) box.append(waCta());
      return box;
    }

    function updateCount(input: HTMLInputElement | HTMLTextAreaElement, out: HTMLElement, max: number, always: boolean) {
      const len = input.value.length;
      const near = len >= max * 0.8;
      out.textContent = `${len}/${max}`;
      out.classList.toggle('is-near', near);
      if (!always) out.hidden = !near;
    }

    function waitCooldown(started: number): Promise<void> {
      const rest = Math.max(0, COOLDOWN - (Date.now() - started));
      return new Promise((r) => setTimeout(r, rest));
    }

    /* ---------- Pestañas ---------- */
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    function selectTab(tab: HTMLButtonElement, focus = false) {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => {
        p.hidden = p.id !== tab.getAttribute('aria-controls');
      });
      if (focus) tab.focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (ev) => {
        let next = -1;
        if (ev.key === 'ArrowRight') next = (i + 1) % tabs.length;
        else if (ev.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        else if (ev.key === 'Home') next = 0;
        else if (ev.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          ev.preventDefault();
          selectTab(tabs[next], true);
        }
      });
    });

    /* ---------- Chat y agenda ---------- */
    function fechaNatural(iso: string): string {
      const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
      if (!m) return iso;
      const d = new Date(Number(m[1]), Number(m[2]) - 1, Number(m[3]));
      const s = new Intl.DateTimeFormat('es-CL', { weekday: 'long', day: 'numeric', month: 'long' })
        .format(d)
        .replace(',', '');
      return s.charAt(0).toUpperCase() + s.slice(1);
    }

    function initChat(panel: HTMLElement) {
      const mode = panel.dataset.mode as 'chat' | 'agenda';
      const hint = panel.dataset.hint || '';
      const log = panel.querySelector<HTMLElement>('[data-log]')!;
      const form = panel.querySelector<HTMLFormElement>('[data-form]')!;
      const input = panel.querySelector<HTMLInputElement>('[data-input]')!;
      const send = panel.querySelector<HTMLButtonElement>('[data-send]')!;
      const count = panel.querySelector<HTMLElement>('[data-count]')!;
      const biz = panel.querySelector<HTMLElement>('[data-biz]')!;
      const avatar = panel.querySelector<HTMLElement>('[data-avatar]')!;
      const rubroBtns = Array.from(panel.querySelectorAll<HTMLButtonElement>('[data-rubro]'));

      let rubro: Rubro = 'gimnasio';
      let history: Msg[] = [];
      let busy = false;

      function setBusy(v: boolean) {
        busy = v;
        send.disabled = v;
        rubroBtns.forEach((b) => (b.disabled = v));
        panel.querySelectorAll<HTMLButtonElement>('.try-suggest .try-chip').forEach((b) => (b.disabled = v));
      }

      function scrollEnd() {
        log.scrollTop = log.scrollHeight;
      }

      function renderEmpty() {
        log.replaceChildren();
        const box = el('div', 'try-empty');
        box.dataset.empty = '';
        box.append(el('p', undefined, hint));
        const list = el('div', 'try-suggest');
        config.rubros[rubro][mode].forEach((q) => {
          const b = el('button', 'try-chip', q);
          b.type = 'button';
          b.addEventListener('click', () => submit(q));
          list.append(b);
        });
        box.append(list);
        log.append(box);
      }

      function reset() {
        history = [];
        const cfg = config.rubros[rubro];
        biz.textContent = cfg.name;
        avatar.textContent = cfg.name.charAt(0);
        input.value = '';
        updateCount(input, count, MAX_USER, false);
        renderEmpty();
      }

      // Deja visible el inicio de la respuesta aunque la tarjeta que la sigue sea alta.
      function scrollToReply(m: HTMLElement) {
        const delta = m.getBoundingClientRect().top - log.getBoundingClientRect().top - 12;
        log.scrollTop = Math.min(log.scrollHeight, log.scrollTop + delta);
      }

      function addMsg(role: 'user' | 'bot', text: string): HTMLElement {
        log.querySelector('[data-empty]')?.remove();
        const m = el('div', `try-msg try-msg-${role}`, text);
        log.append(m);
        scrollEnd();
        return m;
      }

      function addTyping(): HTMLElement {
        const m = el('div', 'try-msg try-msg-bot');
        const t = el('span', 'try-typing');
        t.append(el('span', undefined, 'escribiendo…'));
        const dots = el('span', 'try-dots');
        dots.setAttribute('aria-hidden', 'true');
        dots.append(el('i'), el('i'), el('i'));
        t.append(dots);
        m.append(t);
        log.append(m);
        scrollEnd();
        return m;
      }

      function reservaCard(r: Reserva): HTMLElement {
        const card = el('div', 'try-card');
        const h = el('h3');
        h.append(icon('calendar-check'), document.createTextNode('Hora agendada'));
        const dl = el('dl');
        const rows: [string, string, string?][] = [
          ['Servicio', r.servicio],
          ['Fecha', fechaNatural(r.fecha)],
          ['Hora', `${r.hora} h`],
          ['Código', r.codigo, 'try-code'],
        ];
        rows.forEach(([k, v, c]) => dl.append(el('dt', undefined, k), el('dd', c, v)));
        card.append(h, dl, el('p', undefined, 'Reserva de ejemplo en un negocio ficticio.'));
        return card;
      }

      function windowed(): Msg[] {
        let w = history.slice(-MAX_MSGS);
        if (w[0] && w[0].role === 'assistant') w = w.slice(1);
        return w;
      }

      async function submit(raw: string) {
        const text = raw.trim().slice(0, MAX_USER);
        if (!text || busy) return;
        log.querySelectorAll('.try-notice-error').forEach((n) => n.remove());
        const bubble = addMsg('user', text);
        history.push({ role: 'user', content: text });
        input.value = '';
        updateCount(input, count, MAX_USER, false);
        setBusy(true);
        const typing = addTyping();
        const started = Date.now();
        try {
          const data = await post<AgendaRes & { reply: string }>(mode === 'chat' ? '/chat' : '/agenda', {
            rubro,
            messages: windowed(),
          });
          typing.remove();
          history.push({ role: 'assistant', content: data.reply });
          const reply = addMsg('bot', data.reply);
          if (mode === 'agenda') {
            if (data.reserva) {
              log.append(reservaCard(data.reserva));
              scrollToReply(reply);
            }
            if (data.cancelada) {
              const n = el('div', 'try-notice try-notice-ok');
              const p = el('p');
              p.append(icon('check'), el('span', undefined, `Reserva ${data.cancelada} cancelada.`));
              n.append(p);
              log.append(n);
              scrollEnd();
            }
          }
        } catch (e) {
          typing.remove();
          bubble.remove();
          history.pop();
          input.value = text;
          updateCount(input, count, MAX_USER, false);
          if (history.length === 0) renderEmpty();
          log.append(noticeError(e));
          scrollEnd();
        } finally {
          await waitCooldown(started);
          setBusy(false);
        }
      }

      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        submit(input.value);
      });
      input.addEventListener('input', () => updateCount(input, count, MAX_USER, false));

      rubroBtns.forEach((b) =>
        b.addEventListener('click', () => {
          if (busy) return;
          rubro = b.dataset.rubro as Rubro;
          rubroBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          reset();
        }),
      );

      reset();
    }

    panels.filter((p) => p.dataset.mode === 'chat' || p.dataset.mode === 'agenda').forEach(initChat);

    /* ---------- Redes sociales ---------- */
    (function initSocial() {
      const form = root.querySelector<HTMLFormElement>('[data-social-form]')!;
      const sRubro = root.querySelector<HTMLSelectElement>('[data-s-rubro]')!;
      const sNegocio = root.querySelector<HTMLInputElement>('[data-s-negocio]')!;
      const sObjetivo = root.querySelector<HTMLTextAreaElement>('[data-s-objetivo]')!;
      const sCount = root.querySelector<HTMLElement>('[data-s-count]')!;
      const sError = root.querySelector<HTMLElement>('[data-s-error]')!;
      const submitBtn = root.querySelector<HTMLButtonElement>('[data-s-submit]')!;
      const results = root.querySelector<HTMLElement>('[data-s-results]')!;
      let negocioTouched = false;
      let busy = false;

      sObjetivo.addEventListener('input', () => updateCount(sObjetivo, sCount, 200, true));
      sNegocio.addEventListener('input', () => {
        negocioTouched = true;
      });
      sRubro.addEventListener('change', () => {
        const cfg = config.rubros[sRubro.value as Rubro];
        if (!negocioTouched) sNegocio.value = cfg.negocio;
        sObjetivo.placeholder = cfg.objetivo;
      });

      function showFormError(msg: string) {
        sError.textContent = msg;
        sError.hidden = false;
      }

      function hashtagText(h: string): string {
        const t = h.trim();
        return t.startsWith('#') ? t : `#${t}`;
      }

      async function copyText(text: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          try {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            const ok = document.execCommand('copy');
            ta.remove();
            return ok;
          } catch {
            return false;
          }
        }
      }

      function postCard(p: Post): HTMLElement {
        const card = el('article', 'try-post');
        const head = el('div', 'try-post-head');
        const red = p.red === 'facebook' ? 'facebook' : 'instagram';
        head.append(icon(`${red}-logo`), el('span', undefined, red === 'facebook' ? 'Facebook' : 'Instagram'));
        head.append(el('span', 'try-post-when', `${p.dia} · ${p.hora}`));
        const body = el('p', 'try-post-text', p.texto);
        const tags = el('ul', 'try-tags');
        tags.setAttribute('aria-label', 'Hashtags');
        (p.hashtags || []).forEach((h) => tags.append(el('li', undefined, hashtagText(h))));
        const idea = el('p', 'try-idea');
        idea.append(icon('image'), el('span', undefined, `Idea de imagen: ${p.ideaImagen}`));
        const foot = el('div', 'try-post-foot');
        const btn = el('button', 'btn btn-ghost try-copy');
        btn.type = 'button';
        btn.append(icon('copy'), document.createTextNode('Copiar'));
        const msg = el('span', 'try-copy-msg');
        msg.setAttribute('role', 'status');
        let timer = 0;
        btn.addEventListener('click', async () => {
          const full = [p.texto, (p.hashtags || []).map(hashtagText).join(' ')].filter(Boolean).join('\n\n');
          const ok = await copyText(full);
          clearTimeout(timer);
          msg.textContent = ok ? 'Copiado' : 'No se pudo copiar. Selecciona el texto y cópialo a mano.';
          timer = window.setTimeout(() => (msg.textContent = ''), 2600);
        });
        foot.append(btn, msg);
        card.append(head, body);
        if (tags.childElementCount) card.append(tags);
        card.append(idea, foot);
        return card;
      }

      form.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        if (busy) return;
        const negocio = sNegocio.value.trim().slice(0, 60);
        const objetivo = sObjetivo.value.trim().slice(0, 200);
        if (!negocio) return showFormError('Escribe el nombre del negocio.');
        if (!objetivo) return showFormError('Cuéntame el objetivo de la semana.');
        sError.hidden = true;

        busy = true;
        submitBtn.disabled = true;
        const started = Date.now();
        results.replaceChildren();
        const loading = el('p', 'try-loading', 'Armando las publicaciones de la semana…');
        results.append(loading);
        for (let i = 0; i < 3; i++) results.append(el('div', 'try-skeleton'));

        try {
          const data = await post<{ publicaciones: Post[] }>('/social', { rubro: sRubro.value, negocio, objetivo });
          results.replaceChildren();
          const posts = Array.isArray(data.publicaciones) ? data.publicaciones : [];
          if (!posts.length) throw new ApiError(0, MSG_NETWORK);
          posts.forEach((p) => results.append(postCard(p)));
        } catch (e) {
          results.replaceChildren(noticeError(e));
        } finally {
          await waitCooldown(started);
          busy = false;
          submitBtn.disabled = false;
        }
      });

      updateCount(sObjetivo, sCount, 200, true);
    })();
  }
</script>
