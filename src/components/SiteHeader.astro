---
import Icon from './Icon.astro';
import { DISCORD } from '../data/links';

interface Props {
  current?: 'inicio' | 'tutoriales' | 'consejos';
}

const { current } = Astro.props;
const links = [
  { href: '/tutoriales/', label: 'Tutoriales', id: 'tutoriales' },
  { href: '/#consejos', label: 'Consejos', id: 'consejos' },
];
---

<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/" aria-label="Bryan López, inicio" aria-current={current === 'inicio' ? 'page' : undefined}>
      <span class="brand-mark" aria-hidden="true"><span class="c">&lt;</span>BL<span class="g">&gt;</span></span>
      <span class="brand-name">Bryan López</span>
    </a>
    <nav class="nav" aria-label="Secciones">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="btn btn-primary btn-sm" href={DISCORD} target="_blank" rel="noopener">
      <Icon name="discord-logo" size={18} />Discord
    </a>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(10px);
  }

  .top-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .brand-mark .c {
    color: var(--color-cyan);
  }

  .brand-mark .g {
    color: var(--color-green);
  }

  .nav {
    display: flex;
    gap: 26px;
  }

  .nav a {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 500;
    transition: color 200ms ease;
  }

  .nav a[aria-current='page'] {
    color: var(--color-ink);
    font-weight: 700;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--color-ink);
    }
  }

  .btn-sm {
    padding: 11px 18px;
    font-size: 1rem;
  }

  @media (max-width: 767px) {
    .brand-name {
      display: none;
    }

    .top-inner {
      gap: 16px;
    }

    .nav {
      gap: 16px;
    }
  }

  /* Celulares angostos: queda la marca, Tutoriales y Discord. */
  @media (max-width: 439px) {
    .nav a[href='/#consejos'] {
      display: none;
    }
  }
</style>
