---
// Cabecera de las páginas internas (tutoriales). Misma forma que la de la portada,
// con enlaces que vuelven a las secciones de la portada.
import Icon from './Icon.astro';

interface Props {
  current?: 'tutoriales';
}

const { current } = Astro.props;
const whatsapp =
  'https://wa.me/56994879144?text=' +
  encodeURIComponent('Hola Bryan, vi tu portafolio y quiero conversar sobre mi negocio.');
---

<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/" aria-label="Bryan López, inicio">
      <span class="brand-mark" aria-hidden="true"><span class="c">&lt;</span>BL<span class="g">&gt;</span></span>
      <span class="brand-name">Bryan López</span>
    </a>
    <nav class="nav" aria-label="Secciones">
      <a href="/#trabajos">Trabajos</a>
      <a href="/#servicios">Servicios</a>
      <a href="/tutoriales/" aria-current={current === 'tutoriales' ? 'page' : undefined}>Tutoriales</a>
    </nav>
    <a class="btn btn-primary btn-sm" href={whatsapp} target="_blank" rel="noopener">
      <Icon name="whatsapp-logo" size={18} />Escríbeme
    </a>
  </div>
</header>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in oklab, var(--color-bg) 94%, transparent);
  }

  .top-inner {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 72px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    margin-right: auto;
  }

  .brand-mark .c {
    color: var(--color-cyan);
  }

  .brand-mark .g {
    color: var(--color-green);
  }

  .nav {
    display: flex;
    gap: 26px;
  }

  .nav a {
    text-decoration: none;
    color: var(--color-muted);
    font-weight: 500;
    transition: color 200ms ease;
  }

  .nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--color-ink);
    }
  }

  .btn-sm {
    padding: 11px 18px;
    font-size: 1rem;
  }

  @media (max-width: 767px) {
    .brand-name {
      display: none;
    }

    .nav a:not([href='/tutoriales/']) {
      display: none;
    }

    .top-inner {
      gap: 18px;
    }
  }
</style>
