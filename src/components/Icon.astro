---
// Iconos de Phosphor (peso bold) leídos en build: cero JavaScript en el cliente.
import fs from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
const require = createRequire(import.meta.url);
const file = require.resolve(`@phosphor-icons/core/assets/bold/${name}-bold.svg`);
const svg = fs
  .readFileSync(file, 'utf8')
  .replace('<svg ', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false" class="${className ?? ''}" `);
---

<Fragment set:html={svg} />
